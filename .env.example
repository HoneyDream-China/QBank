# JWT secret key (REQUIRED for production, generate a random string)
SECRET_KEY=change-me-to-a-random-string

# Database (default SQLite, set to postgresql://user:pass@host/db for PostgreSQL)
# DATABASE_URL=sqlite:///./quiz.db

# JWT config
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default admin account (created on first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# CORS origins (comma-separated, * = allow all)
# CORS_ORIGINS=*
